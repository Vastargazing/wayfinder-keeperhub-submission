+# ---------------------------------------------------------------------------
+# Signing callbacks (external executor — no key in this process)
+# ---------------------------------------------------------------------------
+
+
+def get_external_executor_callback(execution: ExternalExecution):
+    """Sign-callback for a wallet whose key lives in an external executor.
+
+    The callback satisfies the sign-callback contract (``wallet_address``,
+    ``chain_type``) so adapters and strategies can be constructed with the
+    executor's address alone. ``send_transaction`` routes every envelope
+    through ``callback.external_execution`` before the
+    sponsored and local paths; the callable itself is never awaited on that
+    path and raises if anything tries to sign locally.
+    """
+
+    async def sign_callback(transaction: dict) -> bytes:
+        raise RuntimeError(
+            "This wallet is executed externally; send_transaction must route "
+            "through sign_callback.external_execution instead of signing locally."
+        )
+
+    sign_callback.wallet_address = execution.wallet_address
+    sign_callback.chain_type = CHAIN_TYPE_ETHEREUM
+    sign_callback.external_execution = execution
+    return sign_callback
+
+
 # ---------------------------------------------------------------------------
 # Wallet resolution → signing callback (unified local/remote)
 # ---------------------------------------------------------------------------
