+++ b/wayfinder_paths/core/utils/executor.py
@@ -0,0 +1,465 @@
+"""External transaction executor seam.
+
+An :class:`ExternalExecution` binds a caller-provided :class:`TransactionExecutor`
+(a service that owns the key and broadcasts on the SDK's behalf) to an
+:class:`OperationJournal` (a local, durable record of every submission). It is
+consulted by :func:`wayfinder_paths.core.utils.transaction.send_transaction`
+*before* the sponsored path and before local signing.
+
+Contract, in order:
+
+1. The SDK builds the unsigned envelope ``{chainId, from, to, data, value}``.
+2. The SDK allocates an operation id and persists ``(operation id, envelope)``
+   to the journal **before** the executor is called. The id is the idempotency
+   key: an executor that has already seen it must not sign a second time.
+3. The executor submits and returns a transaction hash. The SDK records the
+   hash and waits for the receipt itself.
+4. If the executor's answer is lost (exception, timeout, process crash) the
+   SDK raises :class:`ExecutionOutcomeUnknownError` and leaves the journal
+   entry ``pending``. It never falls back to sponsored or local signing — that
+   would open a second send path for the same operation.
+5. On the next send from the same process or a restarted one, every
+   ``pending`` entry is resolved first by asking ``executor.lookup(op_id)``,
+   which answers with a three-valued :class:`LookupResult`:
+
+   - ``landed(hash)``  — the hash is stored ``unconsumed``; the next send of an
+     identical envelope from the same sender claims it instead of resending.
+   - ``never_seen()``  — nothing was signed for this id, so the caller may
+     safely send again. This is a *strong claim* (see :class:`LookupResult`).
+   - ``indeterminate()`` — the executor knows about the id but cannot say
+     whether it reached the chain. Treated exactly like a lookup exception:
+     :class:`ExecutionOutcomeUnknownError`, row stays ``pending``, no new send.
+
+   A two-valued ``hash | None`` lookup cannot express the third case, and
+   collapsing it into "never seen" is a double-send bug: an executor that
+   broadcast and died before recording the hash would be re-sent.
+
+Nonce, gas limit and fee fields are deliberately absent from the envelope: the
+executor owns nonce allocation for its address, so
+:func:`~wayfinder_paths.core.utils.transaction.nonce_transaction` (which reads
+``pending`` transaction counts from the RPC pool) must not run on this path.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+import uuid
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Any, Protocol, runtime_checkable
+
+from loguru import logger
+from web3 import AsyncWeb3
+
+ENVELOPE_KEYS = ("chainId", "from", "to", "data", "value")
+
+
+class ExecutionOutcomeUnknownError(RuntimeError):
+    """The executor was invoked but its answer for ``operation_id`` was lost.
+
+    The operation may or may not have reached the chain. Callers must not
+    retry through another send path; resolve it via ``executor.lookup`` (which
+    :meth:`ExternalExecution.resolve_pending` does on the next send).
+    """
+
+    def __init__(self, operation_id: str, message: str | None = None):
+        self.operation_id = operation_id
+        super().__init__(message or f"Outcome of operation {operation_id} is unknown")
+
+
+class LookupOutcome(Enum):
+    """The three things an executor can honestly say about an operation id."""
+
+    LANDED = "landed"
+    NEVER_SEEN = "never_seen"
+    INDETERMINATE = "indeterminate"
+
+
+@dataclass(frozen=True)
+class LookupResult:
+    """Answer to "what happened to operation X?".
+
+    Three-valued on purpose. A bare ``str | None`` conflates two worlds that
+    demand opposite actions:
+
+    - ``never_seen`` — the executor never received, never signed and never
+      broadcast this id. Proceeding is safe. **This is a strong claim**: the
+      executor may only make it if it durably persists the operation id
+      *before* it does anything that could reach the chain, so that "no
+      record" really does imply "no broadcast". An executor that records the
+      id only after broadcasting must never return ``never_seen``.
+    - ``indeterminate`` — the executor has (or may have) touched this id but
+      cannot prove the outcome: it crashed between broadcast and record, its
+      store is unreachable, the id is in an in-flight state. Proceeding would
+      risk a **double send**, so the SDK treats this exactly like a lookup
+      exception: :class:`ExecutionOutcomeUnknownError`, journal row left
+      ``pending``, nothing new sent, retried on the next attempt.
+
+    A production executor resolves ``indeterminate`` by **reconciling against
+    the chain**, not by guessing: look for a transaction it signed for that
+    operation (its own nonce range / sender / a recorded raw signed payload),
+    verify the receipt, and only then answer ``landed`` or ``never_seen``.
+    KeeperHub already has the two pieces this needs — receipt verification and
+    sign-once/failover reconciliation — which is why the seam pushes the
+    question there instead of resolving it with a heuristic here.
+    """
+
+    outcome: LookupOutcome
+    txn_hash: str | None = None
+    detail: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.outcome is LookupOutcome.LANDED:
+            if not self.txn_hash:
+                raise ValueError("LookupResult.landed requires a transaction hash")
+        elif self.txn_hash:
+            raise ValueError(f"{self.outcome.value} result must not carry a hash")
+
+    @classmethod
+    def landed(cls, txn_hash: str, detail: str | None = None) -> LookupResult:
+        """The executor produced this transaction for that operation id."""
+        return cls(LookupOutcome.LANDED, _normalize_hash(txn_hash), detail)
+
+    @classmethod
+    def never_seen(cls, detail: str | None = None) -> LookupResult:
+        """Nothing was ever signed or broadcast for that id (strong claim)."""
+        return cls(LookupOutcome.NEVER_SEEN, None, detail)
+
+    @classmethod
+    def indeterminate(cls, detail: str | None = None) -> LookupResult:
+        """The executor cannot say whether that id reached the chain."""
+        return cls(LookupOutcome.INDETERMINATE, None, detail)
+
+
+@runtime_checkable
+class TransactionExecutor(Protocol):
+    """A service that signs and broadcasts envelopes for one EVM address.
+
+    ``wallet_address`` is the only address this executor can send from; every
+    envelope's ``from`` must equal it. Implementations must persist
+    ``operation_id`` before signing, because :meth:`lookup` is expected to be
+    authoritative: ``never_seen`` must mean "never signed", never "not indexed
+    yet" — the latter is ``indeterminate``.
+    """
+
+    wallet_address: str
+
+    async def submit(self, envelope: dict[str, Any], *, operation_id: str) -> str:
+        """Sign and broadcast ``envelope``; return the ``0x`` transaction hash."""
+        ...
+
+    async def lookup(self, operation_id: str) -> LookupResult:
+        """Say what became of ``operation_id``: landed / never seen / unknown.
+
+        Returning anything other than a :class:`LookupResult` (a bare hash, or
+        ``None``) is a contract violation and is handled like a failed
+        lookup — no new send — because it cannot distinguish "never signed"
+        from "signed, outcome unrecorded".
+        """
+        ...
+
+
+def build_envelope(transaction: dict[str, Any]) -> dict[str, Any]:
+    """Reduce a transaction dict to the unsigned executor envelope.
+
+    Gas, fee and nonce fields are dropped: they are the executor's to decide.
+    """
+    if "chainId" not in transaction or "from" not in transaction:
+        raise ValueError("Transaction must contain chainId and from")
+    to = transaction.get("to")
+    data = transaction.get("data") or "0x"
+    if isinstance(data, (bytes, bytearray)):
+        data = "0x" + bytes(data).hex()
+    return {
+        "chainId": int(transaction["chainId"]),
+        "from": AsyncWeb3.to_checksum_address(transaction["from"]),
+        "to": AsyncWeb3.to_checksum_address(to) if to else None,
+        "data": data,
+        "value": int(transaction.get("value") or 0),
+    }
+
+
+def envelope_digest(envelope: dict[str, Any]) -> str:
+    """Stable content hash of an envelope, used to match a resumed send."""
+    canonical = json.dumps(
+        {k: envelope.get(k) for k in ENVELOPE_KEYS},
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(canonical.encode()).hexdigest()
+
+
+class OperationJournal:
+    """SQLite-backed record of every envelope handed to an executor.
+
+    States:
+
+    - ``pending``: executor invoked, hash not yet recorded (crash window).
+      Also where an operation stays while its outcome is ``indeterminate`` —
+      the row is deliberately not mutated, so every later send re-asks.
+    - ``submitted``: executor returned (or lookup found) a hash.
+    - ``never_seen``: the executor asserted it never signed this id, so
+      nothing reached the chain and the caller may send again. Terminal.
+    - ``orphaned``: landed after a crash but the caller moved on to a newer
+      operation without claiming it. Needs human/driver reconciliation.
+
+    There is no ``indeterminate`` state: an undetermined outcome is not a
+    resting place. It stays ``pending`` and blocks new sends for that sender
+    until the executor can answer ``landed`` or ``never_seen``.
+
+    ``consumed`` marks whether the hash was returned to the SDK caller. A
+    ``submitted`` + unconsumed row is a landed send whose caller crashed
+    before learning the hash. :meth:`claim` hands it to the next send only if
+    that send is the identical envelope *and* nothing newer was begun since —
+    i.e. the caller resumed at the step that was in flight. Anything else is a
+    driver that re-ran earlier steps, and guessing there would double-execute.
+    """
+
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._conn = sqlite3.connect(self.path, isolation_level=None)
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS operations (
+                operation_id TEXT PRIMARY KEY,
+                sender       TEXT NOT NULL,
+                chain_id     INTEGER NOT NULL,
+                digest       TEXT NOT NULL,
+                envelope     TEXT NOT NULL,
+                state        TEXT NOT NULL,
+                txn_hash     TEXT,
+                consumed     INTEGER NOT NULL DEFAULT 0,
+                created_at   REAL NOT NULL DEFAULT (unixepoch('subsec')),
+                updated_at   REAL NOT NULL DEFAULT (unixepoch('subsec'))
+            )
+            """
+        )
+
+    def close(self) -> None:
+        self._conn.close()
+
+    def begin(self, envelope: dict[str, Any]) -> str:
+        """Persist a new ``pending`` operation and return its id.
+
+        This commits before returning; the executor must only be called after.
+        Any landed-but-unclaimed operation for the same sender becomes
+        ``orphaned``: it is no longer the latest, so it can never be claimed.
+        """
+        operation_id = uuid.uuid4().hex
+        self._conn.execute(
+            "UPDATE operations SET state='orphaned', updated_at=unixepoch('subsec')"
+            " WHERE state='submitted' AND consumed=0 AND sender=? AND chain_id=?",
+            (envelope["from"].lower(), int(envelope["chainId"])),
+        )
+        self._conn.execute(
+            "INSERT INTO operations (operation_id, sender, chain_id, digest, envelope, state)"
+            " VALUES (?, ?, ?, ?, ?, 'pending')",
+            (
+                operation_id,
+                envelope["from"].lower(),
+                int(envelope["chainId"]),
+                envelope_digest(envelope),
+                json.dumps(envelope, sort_keys=True),
+            ),
+        )
+        return operation_id
+
+    def record_hash(self, operation_id: str, txn_hash: str, *, consumed: bool) -> None:
+        self._conn.execute(
+            "UPDATE operations SET state='submitted', txn_hash=?, consumed=?,"
+            " updated_at=unixepoch('subsec') WHERE operation_id=?",
+            (txn_hash, int(consumed), operation_id),
+        )
+
+    def mark_never_seen(self, operation_id: str) -> None:
+        """Record the executor's assertion that this id was never signed."""
+        self._conn.execute(
+            "UPDATE operations SET state='never_seen', updated_at=unixepoch('subsec')"
+            " WHERE operation_id=?",
+            (operation_id,),
+        )
+
+    def pending(self, sender: str, chain_id: int) -> list[dict[str, Any]]:
+        rows = self._conn.execute(
+            "SELECT operation_id, envelope FROM operations"
+            " WHERE state='pending' AND sender=? AND chain_id=? ORDER BY created_at",
+            (sender.lower(), int(chain_id)),
+        ).fetchall()
+        return [{"operation_id": r[0], "envelope": json.loads(r[1])} for r in rows]
+
+    def claim(self, envelope: dict[str, Any]) -> tuple[str, str] | None:
+        """Consume the latest operation if it landed unclaimed and matches ``envelope``.
+
+        Returns ``(operation_id, txn_hash)`` or None. Only operations resolved
+        after a crash are ever unconsumed, and only the most recent one is
+        eligible, so a legitimate repeat of an identical envelope is never
+        swallowed in normal operation.
+        """
+        row = self._conn.execute(
+            "SELECT operation_id, txn_hash, state, consumed, digest FROM operations"
+            " WHERE sender=? AND chain_id=? ORDER BY created_at DESC LIMIT 1",
+            (envelope["from"].lower(), int(envelope["chainId"])),
+        ).fetchone()
+        if (
+            row is None
+            or row[2] != "submitted"
+            or row[3]
+            or row[4] != envelope_digest(envelope)
+        ):
+            return None
+        self._conn.execute(
+            "UPDATE operations SET consumed=1, updated_at=unixepoch('subsec')"
+            " WHERE operation_id=?",
+            (row[0],),
+        )
+        return row[0], row[1]
+
+    def entries(self) -> list[dict[str, Any]]:
+        """All rows, oldest first (diagnostics / tests)."""
+        rows = self._conn.execute(
+            "SELECT operation_id, sender, chain_id, digest, envelope, state, txn_hash,"
+            " consumed, created_at, updated_at FROM operations ORDER BY created_at"
+        ).fetchall()
+        keys = (
+            "operation_id",
+            "sender",
+            "chain_id",
+            "digest",
+            "envelope",
+            "state",
+            "txn_hash",
+            "consumed",
+            "created_at",
+            "updated_at",
+        )
+        out = []
+        for r in rows:
+            d = dict(zip(keys, r, strict=True))
+            d["envelope"] = json.loads(d["envelope"])
+            d["consumed"] = bool(d["consumed"])
+            out.append(d)
+        return out
+
+
+class ExternalExecution:
+    """Binds a :class:`TransactionExecutor` to an :class:`OperationJournal`.
+
+    Attach it to a sign callback as ``sign_callback.external_execution`` (see
+    :func:`wayfinder_paths.core.utils.wallets.get_external_executor_callback`)
+    and ``send_transaction`` routes every envelope through :meth:`send`.
+    """
+
+    def __init__(self, executor: TransactionExecutor, journal: OperationJournal):
+        self.executor = executor
+        self.journal = journal
+        self.wallet_address = AsyncWeb3.to_checksum_address(executor.wallet_address)
+
+    async def resolve_pending(self, chain_id: int) -> list[dict[str, Any]]:
+        """Ask the executor about every ``pending`` operation for our address.
+
+        Landed hashes are recorded unconsumed so an identical re-send can claim
+        them; ids the executor asserts it never signed become ``never_seen``.
+        An ``indeterminate`` answer — and a lookup that raises, or returns
+        something that is not a :class:`LookupResult` — raises
+        :class:`ExecutionOutcomeUnknownError`: nothing new may be sent while an
+        earlier outcome is undetermined, and the row stays ``pending`` so the
+        next attempt asks again.
+        """
+        resolved = []
+        for entry in self.journal.pending(self.wallet_address, chain_id):
+            op_id = entry["operation_id"]
+            try:
+                result = _require_lookup_result(await self.executor.lookup(op_id))
+            except Exception as exc:  # noqa: BLE001
+                raise ExecutionOutcomeUnknownError(
+                    op_id, f"lookup for pending operation {op_id} failed: {exc}"
+                ) from exc
+
+            if result.outcome is LookupOutcome.INDETERMINATE:
+                logger.error(
+                    f"Executor cannot determine the outcome of operation {op_id}"
+                    f" ({result.detail or 'no detail'}); it stays pending"
+                )
+                raise ExecutionOutcomeUnknownError(
+                    op_id,
+                    f"executor reported an indeterminate outcome for operation "
+                    f"{op_id}: {result.detail or 'no detail'}. It may already be "
+                    f"on chain; reconcile against the chain before sending again.",
+                )
+            if result.outcome is LookupOutcome.LANDED:
+                assert result.txn_hash is not None  # guaranteed by LookupResult
+                self.journal.record_hash(op_id, result.txn_hash, consumed=False)
+                logger.info(f"Pending operation {op_id} landed as {result.txn_hash}")
+            else:
+                self.journal.mark_never_seen(op_id)
+                logger.warning(
+                    f"Executor asserts it never signed operation {op_id}"
+                    f" ({result.detail or 'no detail'}); safe to send again"
+                )
+            resolved.append(
+                {
+                    **entry,
+                    "outcome": result.outcome.value,
+                    "txn_hash": result.txn_hash,
+                }
+            )
+        return resolved
+
+    async def send(self, transaction: dict[str, Any]) -> str:
+        """Submit ``transaction`` through the executor and return its hash."""
+        envelope = build_envelope(transaction)
+        if envelope["from"] != self.wallet_address:
+            raise ValueError(
+                f"Envelope from={envelope['from']} does not match executor "
+                f"address {self.wallet_address}"
+            )
+        chain_id = envelope["chainId"]
+
+        await self.resolve_pending(chain_id)
+
+        claimed = self.journal.claim(envelope)
+        if claimed is not None:
+            op_id, txn_hash = claimed
+            logger.info(
+                f"Reusing landed operation {op_id} ({txn_hash}) instead of resending"
+            )
+            return txn_hash
+
+        op_id = self.journal.begin(envelope)  # durable before the executor sees it
+        logger.info(f"Submitting operation {op_id} to external executor: {envelope}")
+        try:
+            txn_hash = await self.executor.submit(envelope, operation_id=op_id)
+        except Exception as exc:  # noqa: BLE001
+            # Leave the row pending: the executor may have signed. No fallback.
+            raise ExecutionOutcomeUnknownError(
+                op_id, f"executor did not answer for operation {op_id}: {exc}"
+            ) from exc
+        if not txn_hash:
+            raise ExecutionOutcomeUnknownError(
+                op_id, f"executor returned no hash for operation {op_id}"
+            )
+        txn_hash = _normalize_hash(txn_hash)
+        self.journal.record_hash(op_id, txn_hash, consumed=True)
+        return txn_hash
+
+
+def _require_lookup_result(value: object) -> LookupResult:
+    """Reject a two-valued lookup loudly instead of guessing what it meant."""
+    if isinstance(value, LookupResult):
+        return value
+    raise TypeError(
+        "TransactionExecutor.lookup must return a LookupResult "
+        f"(landed / never_seen / indeterminate); got {value!r}. A bare hash or "
+        "None cannot distinguish 'never signed' from 'signed, outcome "
+        "unrecorded', and treating the latter as the former double-sends."
+    )
+
+
+def _normalize_hash(txn_hash: str) -> str:
+    h = txn_hash if isinstance(txn_hash, str) else "0x" + bytes(txn_hash).hex()
+    return h if h.startswith("0x") else f"0x{h}"
