+class TestDurableSteps:
+    @pytest.mark.asyncio
+    async def test_consumed_step_keeps_identity_across_reopen(self, tmp_path):
+        path = tmp_path / 'steps.sqlite'
+        journal = OperationJournal(path)
+        executor = RecordingExecutor(journal)
+        execution = ExternalExecution(executor, journal)
+        with execution.step('run/iteration-1/borrow'):
+            first = await execution.send(TX)
+        journal.close()
+        journal = OperationJournal(path)
+        executor.journal = journal
+        execution = ExternalExecution(executor, journal)
+        with execution.step('run/iteration-1/borrow'):
+            assert await execution.send(TX) == first
+        assert executor.submits == 1
+        with pytest.raises(ValueError, match='step identity/envelope conflict'):
+            with execution.step('run/iteration-1/borrow'):
+                await execution.send({**TX, 'value': 1})
+        assert executor.submits == 1
+        with execution.step('run/iteration-2/borrow'):
+            assert await execution.send(TX) != first
+        assert executor.submits == 2
+        journal.close()
+
+    @pytest.mark.asyncio
+    async def test_step_loss_resolves_original_without_resend(self, journal):
+        executor = RecordingExecutor(journal)
+        executor.lose_response = True
+        execution = ExternalExecution(executor, journal)
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            with execution.step('run/1/wrap'):
+                await execution.send(TX)
+        operation = journal.entries()[0]['operation_id']
+        with execution.step('run/1/wrap'):
+            assert await execution.send(TX) == executor.records[operation]['hash']
+        assert executor.submits == 1
+        assert journal._conn.execute('SELECT operation_id FROM execution_steps').fetchone()[0] == operation
+
+    @pytest.mark.asyncio
+    async def test_validator_refusal_prevents_hash_transition(self, journal):
