@@ -0,0 +1,300 @@
+from unittest.mock import patch
+
+import pytest
+
+from wayfinder_paths.core.utils.executor import (
+    ExecutionOutcomeUnknownError,
+    ExternalExecution,
+    LookupOutcome,
+    LookupResult,
+    OperationJournal,
+    build_envelope,
+)
+from wayfinder_paths.core.utils.transaction import send_transaction
+from wayfinder_paths.core.utils.wallets import get_external_executor_callback
+
+SENDER = "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed"
+TARGET = "0xA238Dd80C259a72e81d7e4664a9801593F98d1c5"
+TX = {"chainId": 8453, "from": SENDER, "to": TARGET, "data": "0x1234", "value": 0}
+
+
+class RecordingExecutor:
+    """Minimal TransactionExecutor with the same durability model as a real one.
+
+    An operation id is persisted as ``signing`` *before* the broadcast and
+    updated to ``broadcast`` with the hash after, so ``lookup`` can answer all
+    three values: no record -> ``never_seen``, ``signing`` -> ``indeterminate``
+    (it may or may not have reached the chain), hash -> ``landed``.
+    """
+
+    def __init__(self, journal: OperationJournal | None = None):
+        self.wallet_address = SENDER
+        self.journal = journal
+        self.records: dict[str, dict] = {}
+        self.submits = 0
+        self.lose_response = False
+        #: False models a crash between broadcast and recording the hash.
+        self.record_hash_after_broadcast = True
+        self.pending_at_submit: list[str] = []
+
+    async def submit(self, envelope, *, operation_id):
+        self.submits += 1
+        if self.journal is not None:
+            self.pending_at_submit = [
+                e["operation_id"]
+                for e in self.journal.pending(envelope["from"], envelope["chainId"])
+            ]
+        self.records[operation_id] = {"status": "signing"}  # persisted BEFORE broadcast
+        txn_hash = f"0x{self.submits:064x}"
+        if self.record_hash_after_broadcast:
+            self.records[operation_id] = {"status": "broadcast", "hash": txn_hash}
+        if self.lose_response:
+            raise TimeoutError("response lost")
+        return txn_hash
+
+    async def lookup(self, operation_id):
+        record = self.records.get(operation_id)
+        if record is None:
+            return LookupResult.never_seen(
+                "no record; ids are persisted before signing"
+            )
+        if record.get("hash"):
+            return LookupResult.landed(record["hash"])
+        return LookupResult.indeterminate(
+            f"operation is {record['status']}; broadcast outcome unrecorded"
+        )
+
+
+@pytest.fixture
+def journal(tmp_path):
+    j = OperationJournal(tmp_path / "ops.sqlite")
+    yield j
+    j.close()
+
+
+class TestBuildEnvelope:
+    def test_drops_gas_nonce_and_fee_fields(self):
+        env = build_envelope(
+            {**TX, "gas": 1, "nonce": 7, "maxFeePerGas": 2, "gasPrice": 3}
+        )
+        assert env == {
+            "chainId": 8453,
+            "from": SENDER,
+            "to": TARGET,
+            "data": "0x1234",
+            "value": 0,
+        }
+
+    def test_requires_chain_and_from(self):
+        with pytest.raises(ValueError):
+            build_envelope({"to": TARGET})
+
+
+class TestLookupResult:
+    def test_landed_requires_and_normalizes_a_hash(self):
+        assert LookupResult.landed("abc").txn_hash == "0xabc"
+        with pytest.raises(ValueError):
+            LookupResult(LookupOutcome.LANDED)
+
+    def test_no_hash_may_be_attached_to_the_other_two(self):
+        assert LookupResult.never_seen().txn_hash is None
+        assert LookupResult.indeterminate("store unreachable").txn_hash is None
+        with pytest.raises(ValueError):
+            LookupResult(LookupOutcome.NEVER_SEEN, "0xabc")
+        with pytest.raises(ValueError):
+            LookupResult(LookupOutcome.INDETERMINATE, "0xabc")
+
+
+@pytest.mark.asyncio
+class TestSendTransactionViaExecutor:
+    async def test_executor_runs_before_sponsored_and_local_paths(self, journal):
+        executor = RecordingExecutor(journal)
+        cb = get_external_executor_callback(ExternalExecution(executor, journal))
+        assert cb.wallet_address == SENDER
+
+        with (
+            patch("wayfinder_paths.core.utils.transaction.gas_limit_transaction") as gl,
+            patch("wayfinder_paths.core.utils.transaction.nonce_transaction") as nonce,
+            patch("wayfinder_paths.core.utils.transaction.gas_price_transaction") as gp,
+            patch("wayfinder_paths.core.utils.transaction.broadcast_transaction") as bc,
+            patch(
+                "wayfinder_paths.core.utils.transaction.send_sponsored_transaction"
+            ) as sponsored,
+            patch("wayfinder_paths.core.utils.transaction.sponsorship_enabled") as se,
+            patch(
+                "wayfinder_paths.core.utils.transaction.wait_for_transaction_receipt"
+            ) as wait,
+        ):
+            wait.return_value = {"status": 1, "blockNumber": 10}
+            txn_hash = await send_transaction(TX, cb, wait_for_receipt=True)
+
+        assert txn_hash == f"0x{1:064x}"
+        # journal row existed (pending) at the moment the executor was invoked
+        assert executor.pending_at_submit == [journal.entries()[0]["operation_id"]]
+        for m in (gl, nonce, gp, bc, sponsored, se):
+            m.assert_not_called()
+        wait.assert_awaited_once()
+        assert wait.await_args.args[:2] == (8453, txn_hash)
+        (entry,) = journal.entries()
+        assert entry["state"] == "submitted" and entry["consumed"] is True
+        assert entry["envelope"] == build_envelope(TX)
+
+    async def test_lost_response_is_unknown_not_fallback(self, journal):
+        executor = RecordingExecutor(journal)
+        executor.lose_response = True
+        cb = get_external_executor_callback(ExternalExecution(executor, journal))
+
+        with (
+            patch("wayfinder_paths.core.utils.transaction.broadcast_transaction") as bc,
+            patch(
+                "wayfinder_paths.core.utils.transaction.send_sponsored_transaction"
+            ) as sponsored,
+            patch(
+                "wayfinder_paths.core.utils.transaction.wait_for_transaction_receipt"
+            ) as wait,
+        ):
+            with pytest.raises(ExecutionOutcomeUnknownError) as excinfo:
+                await send_transaction(TX, cb)
+
+        bc.assert_not_called()
+        sponsored.assert_not_called()
+        wait.assert_not_called()
+        (entry,) = journal.entries()
+        assert entry["state"] == "pending"
+        assert excinfo.value.operation_id == entry["operation_id"]
+
+    async def test_lookup_landed_adopts_the_transaction_without_resending(
+        self, journal
+    ):
+        executor = RecordingExecutor(journal)
+        executor.lose_response = True
+        first = ExternalExecution(executor, journal)
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await first.send(TX)
+        assert executor.submits == 1
+
+        # "Restart": a fresh binding over the same durable journal + executor.
+        executor.lose_response = False
+        second = ExternalExecution(executor, journal)
+        txn_hash = await second.send(TX)  # identical envelope -> claimed
+        assert txn_hash == f"0x{1:064x}"
+        assert executor.submits == 1  # no resend
+        (entry,) = journal.entries()
+        assert entry["state"] == "submitted" and entry["consumed"] is True
+
+        # A different envelope after recovery is a brand-new operation.
+        other = await second.send({**TX, "data": "0x5678"})
+        assert other == f"0x{2:064x}"
+        assert executor.submits == 2
+        assert len(journal.entries()) == 2
+
+    async def test_orphan_is_not_claimable_after_a_newer_operation(self, journal):
+        # Crash on step B of [A, B]; the driver then re-runs from the top. B's
+        # landed send must not be handed to the *second* B, or the second run's
+        # B would silently be skipped.
+        executor = RecordingExecutor(journal)
+        tx_a, tx_b = TX, {**TX, "data": "0xbbbb"}
+        executor.lose_response = True
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await ExternalExecution(executor, journal).send(tx_b)
+        executor.lose_response = False
+
+        resumed = ExternalExecution(executor, journal)
+        await resumed.send(tx_a)  # newer op: orphan is no longer latest
+        second_b = await resumed.send(tx_b)
+        assert second_b == f"0x{3:064x}"
+        assert executor.submits == 3
+        by_state = sorted(e["state"] for e in journal.entries())
+        assert by_state == ["orphaned", "submitted", "submitted"]
+        orphan = next(e for e in journal.entries() if e["state"] == "orphaned")
+        assert orphan["txn_hash"] == f"0x{1:064x}" and orphan["consumed"] is False
+
+    async def test_lookup_never_seen_lets_the_caller_send_again(self, journal):
+        # The SDK committed the journal row and died before the executor was
+        # ever reached: the executor has no record, so nothing was signed.
+        executor = RecordingExecutor(journal)
+        lost_id = journal.begin(build_envelope(TX))
+        assert (await executor.lookup(lost_id)).outcome is LookupOutcome.NEVER_SEEN
+
+        txn_hash = await ExternalExecution(executor, journal).send(TX)
+        assert txn_hash == f"0x{1:064x}"
+        states = {e["operation_id"]: e["state"] for e in journal.entries()}
+        assert states[lost_id] == "never_seen"
+        assert executor.submits == 1
+
+    async def test_lookup_indeterminate_blocks_new_sends(self, journal):
+        # The executor broadcast and died before recording the hash. A
+        # two-valued lookup would say "no hash -> never seen" and the SDK
+        # would send a second time. Three-valued: nothing is sent at all.
+        executor = RecordingExecutor(journal)
+        executor.record_hash_after_broadcast = False
+        executor.lose_response = True
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await ExternalExecution(executor, journal).send(TX)
+        assert executor.submits == 1
+        (entry,) = journal.entries()
+        assert entry["state"] == "pending"
+
+        executor.lose_response = False
+        with pytest.raises(ExecutionOutcomeUnknownError) as excinfo:
+            await ExternalExecution(executor, journal).send(TX)  # restart
+        assert "indeterminate" in str(excinfo.value)
+        assert excinfo.value.operation_id == entry["operation_id"]
+        assert executor.submits == 1  # no second send
+        (entry,) = journal.entries()
+        assert entry["state"] == "pending"  # still pending: not a resting state
+
+    async def test_indeterminate_clears_once_the_executor_reconciles(self, journal):
+        # Same crash, then the executor reconciles against the chain and can
+        # answer landed. Only now does the SDK adopt the transaction.
+        executor = RecordingExecutor(journal)
+        executor.record_hash_after_broadcast = False
+        executor.lose_response = True
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await ExternalExecution(executor, journal).send(TX)
+        executor.lose_response = False
+        (op_id,) = [e["operation_id"] for e in journal.entries()]
+
+        executor.records[op_id] = {"status": "broadcast", "hash": f"0x{1:064x}"}
+        txn_hash = await ExternalExecution(executor, journal).send(TX)
+        assert txn_hash == f"0x{1:064x}"
+        assert executor.submits == 1  # adopted, never resent
+        (entry,) = journal.entries()
+        assert entry["state"] == "submitted" and entry["consumed"] is True
+
+    async def test_two_valued_lookup_is_rejected_not_guessed(self, journal):
+        class LegacyLookup(RecordingExecutor):
+            async def lookup(self, operation_id):
+                record = self.records.get(operation_id) or {}
+                return record.get("hash")  # the old `str | None` contract
+
+        executor = LegacyLookup(journal)
+        journal.begin(build_envelope(TX))
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await ExternalExecution(executor, journal).send(TX)
+        assert executor.submits == 0
+        assert journal.entries()[0]["state"] == "pending"
+
+    async def test_lookup_failure_blocks_new_sends(self, journal):
+        class BrokenLookup(RecordingExecutor):
+            async def lookup(self, operation_id):
+                raise ConnectionError("executor unreachable")
+
+        executor = BrokenLookup(journal)
+        journal.begin(build_envelope(TX))
+        with pytest.raises(ExecutionOutcomeUnknownError):
+            await ExternalExecution(executor, journal).send(TX)
+        assert executor.submits == 0
+
+    async def test_from_must_match_executor_address(self, journal):
+        execution = ExternalExecution(RecordingExecutor(journal), journal)
+        with pytest.raises(ValueError, match="does not match executor"):
+            await execution.send({**TX, "from": TARGET})
+        assert journal.entries() == []
+
+    async def test_callback_refuses_to_sign_locally(self, journal):
+        cb = get_external_executor_callback(
+            ExternalExecution(RecordingExecutor(journal), journal)
+        )
+        with pytest.raises(RuntimeError, match="executed externally"):
+            await cb(TX)
