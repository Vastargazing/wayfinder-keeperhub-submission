+    def test_entry_base_sepolia_is_supported(self, adapter):
+        entry = adapter._entry(self.BASE_SEPOLIA)
+        assert entry["pool"] == self.BASE_SEPOLIA_POOL
+        # Not Base mainnet's pool, and not any other chain's.
+        assert entry["pool"] != self.BASE_MAINNET_POOL
+        others = {
+            cid: e["pool"]
+            for cid, e in AAVE_V3_BY_CHAIN.items()
+            if cid != self.BASE_SEPOLIA
+        }
+        assert self.BASE_SEPOLIA_POOL not in others.values()
+
+    def test_entry_unknown_chain_is_still_rejected(self, adapter):
+        # Adding a chain must not turn _entry into a permissive lookup.
+        with pytest.raises(ValueError, match=r"Unsupported Aave v3 chain_id=1234567"):
+            adapter._entry(1234567)
+
+    def test_base_sepolia_entry_has_the_same_keys_as_base_mainnet(self):
+        assert set(AAVE_V3_BY_CHAIN[self.BASE_SEPOLIA]) == set(AAVE_V3_BY_CHAIN[8453])
+
+    def test_base_sepolia_addresses_are_checksummed_and_distinct(self):
+        entry = AAVE_V3_BY_CHAIN[self.BASE_SEPOLIA]
+        for key, value in entry.items():
+            assert value == to_checksum_address(value), key
+        # Seven distinct roles, seven distinct contracts: a duplicated value
+        # would mean a key was filled in from the wrong source.
+        assert len(set(entry.values())) == len(entry)
